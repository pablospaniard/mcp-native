{
  "name": "@mcp-native/react-native",
  "version": "0.9.0",
  "description": "React Native renderer primitives for MCP Native.",
  "keywords": [
    "a2ui",
    "mcp",
    "model-context-protocol",
    "native-ui",
    "react-native"
  ],
  "homepage": "https://github.com/pablospaniard/mcp-native#readme",
  "bugs": {
    "url": "https://github.com/pablospaniard/mcp-native/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablospaniard/mcp-native.git",
    "directory": "packages/react-native"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mcp-native/a2ui": "^0.9.0",
    "@mcp-native/core": "^0.9.0"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "react": "19.2.8",
    "test-renderer": "1.2.0"
  },
  "peerDependencies": {
    "react": ">=18.3.1 <20",
    "react-native": ">=0.87.0 <1"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
