{
  "name": "mcp-native",
  "version": "1.0.0-beta.2",
  "description": "Convenience package for the MCP Native runtime.",
  "keywords": [
    "a2ui",
    "mcp",
    "model-context-protocol",
    "native-ui",
    "react-native"
  ],
  "homepage": "https://github.com/pablospaniard/mcp-native#readme",
  "bugs": {
    "url": "https://github.com/pablospaniard/mcp-native/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablospaniard/mcp-native.git",
    "directory": "packages/mcp-native"
  },
  "bin": {
    "mcp-native": "bin/mcp-native.mjs"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js",
      "default": "./dist/legacy.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mcp-native/a2ui": "^1.0.0-beta.2",
    "@mcp-native/core": "^1.0.0-beta.2",
    "@mcp-native/react-native": "^1.0.0-beta.2",
    "@mcp-native/webview": "^1.0.0-beta.2"
  },
  "peerDependencies": {
    "react": ">=18.1.0"
  }
}
