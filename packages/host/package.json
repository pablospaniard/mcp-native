{
  "name": "@mcp-native/host",
  "version": "1.0.0-beta.1",
  "description": "High-level MCP host orchestration for MCP Native.",
  "keywords": [
    "a2ui",
    "host",
    "mcp",
    "mcp-apps",
    "model-context-protocol",
    "react-native"
  ],
  "homepage": "https://github.com/pablospaniard/mcp-native#readme",
  "bugs": {
    "url": "https://github.com/pablospaniard/mcp-native/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablospaniard/mcp-native.git",
    "directory": "packages/host"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.js",
      "default": "./dist/react-native.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mcp-native/a2ui": "^1.0.0-beta.1",
    "@mcp-native/core": "^1.0.0-beta.1",
    "@mcp-native/mcp": "^1.0.0-beta.1",
    "@mcp-native/react-native": "^1.0.0-beta.1",
    "@mcp-native/webview": "^1.0.0-beta.1"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "react": "19.2.8",
    "test-renderer": "1.2.0"
  },
  "peerDependencies": {
    "react": ">=18.1.0"
  }
}
