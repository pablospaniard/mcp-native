{
  "name": "mcp-native-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Native application runtime for MCP, focused first on React Native.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run schemas:verify && npm run native:evidence:check && npm run test:coverage && npm run test:performance && npm run test:conformance",
    "clean": "tsc -b --clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives .",
    "native:evidence:check": "node scripts/verify-native-accessibility-evidence.mjs",
    "native:evidence:verify": "node scripts/verify-native-accessibility-evidence.mjs --strict",
    "native:host:prepare": "node scripts/prepare-native-host.mjs",
    "package:smoke": "npm run build && node scripts/smoke-packages.mjs",
    "prepare": "husky",
    "release:verify": "npm run check && npm run native:evidence:verify && npm run package:smoke && node scripts/verify-release-version.mjs",
    "schemas:verify": "node scripts/verify-a2ui-schemas.mjs",
    "test": "npm run build && npm run test:unit",
    "test:conformance": "npm run build && node scripts/run-mcp-conformance.mjs",
    "test:coverage": "npm run build && c8 node --test tests/*.test.mjs",
    "test:performance": "npm run build && node --expose-gc scripts/run-a2ui-performance.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@modelcontextprotocol/server": "2.0.0",
    "c8": "^12.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
